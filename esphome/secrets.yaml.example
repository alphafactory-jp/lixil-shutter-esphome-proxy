# secrets.yaml.example を secrets.yaml にコピーして値を入れてください。
# Copy to secrets.yaml and fill in. secrets.yaml is ignored by git.
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"
# 32 バイトの Base64。https://esphome.io/components/api/ のページで生成できます。
ble_proxy_api_key: "generate-a-32-byte-base64-key"
ble_proxy_ota_password: "your-ota-password"
